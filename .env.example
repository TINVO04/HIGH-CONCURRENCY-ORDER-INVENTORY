# Local-only defaults. Copy to .env for local overrides; never commit real credentials.
POSTGRES_DB=orderservice
POSTGRES_USER=orderservice
POSTGRES_PASSWORD=orderservice_dev_only
POSTGRES_PORT=5432
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Optional explicit API connection string. Keep the container hostname `postgres` here.
# CONNECTIONSTRINGS__POSTGRESQL=Host=postgres;Port=5432;Database=orderservice;Username=orderservice;Password=orderservice_dev_only

# Integration tests use a separate database connection when supplied. The test fixture
# also supports TESTCONTAINERS_ENABLED=true when Docker/Testcontainers is available.
# TEST_DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=orderservice_tests;Username=orderservice;Password=orderservice_dev_only
# TESTCONTAINERS_ENABLED=false
